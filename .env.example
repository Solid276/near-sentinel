# Required: Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Optional: NEAR AI Cloud key for AI Risk Analyst
NEAR_AI_API_KEY=
NEAR_AI_MODEL=z-ai/glm-5.3-flash

# NEAR mainnet RPC (read-only)
NEAR_RPC_PRIMARY=https://rpc.mainnet.fastnear.com
NEAR_RPC_FALLBACK=https://1rpc.io/near

# Lending and oracle configuration
LENDING_CONTRACT_ID=contract.main.burrow.near
PRICE_CONFIG_CONTRACT_ID=oracle-prices.near
PRICE_CONFIG_METHOD=get_config

# Local server
PORT=3000
HOST=127.0.0.1

# Local database
DATABASE_PATH=./data/risk-monitor.sqlite

# Monitoring and alert settings
POLL_SECONDS=60
RATE_LIMIT_SECONDS=15
ALERT_COOLDOWN_MINUTES=60
MAX_PRICE_AGE_SECONDS=180
