{
  "name": "near-sentinel",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered DeFi risk intelligence and early-warning agent for NEAR",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
